{
  "name": "@valstro-internal/ghdash-tui",
  "version": "0.1.0",
  "description": "GitHub PR status dashboard TUI built with OpenTUI Solid",
  "type": "module",
  "private": true,
  "bin": {
    "ghdash-tui": "./dist/ghdash-tui-linux-x64/bin/ghdash-tui"
  },
  "scripts": {
    "dev": "bun run --conditions=browser --preload @opentui/solid/preload ./src/index.tsx",
    "dev:watch": "bun run --watch --conditions=browser --preload @opentui/solid/preload ./src/index.tsx",
    "dev:fixture": "GHDASH_FIXTURE=${GHDASH_FIXTURE:-default} bun run --watch --conditions=browser --preload @opentui/solid/preload ./src/index.tsx",
    "debug": "SHOW_CONSOLE=true bun run --inspect-wait --conditions=browser --preload @opentui/solid/preload ./src/index.tsx",
    "build": "bun build ./src/index.tsx --outdir=./dist --target=bun",
    "build:binary": "bun run script/build.ts",
    "build:binary:single": "bun run script/build.ts --single",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@opentui/core": "0.1.97",
    "@opentui/solid": "0.1.97",
    "citty": "^0.2.2",
    "effection": "4.0.2",
    "marked": "^17.0.1",
    "octokit": "^4.0.2",
    "solid-js": "1.9.9"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "25.2.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  }
}
